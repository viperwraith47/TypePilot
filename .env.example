# TypePilot — GitHub OAuth (optional)
#
# Register a GitHub OAuth App at:
#   https://github.com/settings/developers → OAuth Apps → New OAuth App
#
#   Application name: TypePilot
#   Homepage URL:     https://typepilot.org
#   Authorization callback URL:
#       https://YOUR_DEV_EXTENSION_ID.chromiumapp.org/
#       https://YOUR_PROD_EXTENSION_ID.chromiumapp.org/
#
# Copy the "Client ID" (NOT the secret) below.
# The secret is never used — TypePilot uses the PKCE flow for public clients.

GITHUB_CLIENT_ID=
